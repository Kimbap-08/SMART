    </Compile>
    <Compile Update="InstructorCalendar.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="AnnouncementsAdmin.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="InboxControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <EmbeddedResource Update="InboxControl.resx">
      <DependentUpon>InboxControl.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="AnnouncementsAdmin.resx">
