    </Compile>
    <Compile Update="InstructorAnnouncementCard.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="InstructorAnnouncementCard.Designer.cs">
      <DependentUpon>InstructorAnnouncementCard.cs</DependentUpon>
    </Compile>
    <Compile Update="InstructorAnnouncementDetailsDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="InstructorAnnouncementDetailsDialog.Designer.cs">
