    </EmbeddedResource>
    <Compile Update="InstructorSettings.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="InstructorSettings.Designer.cs">
      <DependentUpon>InstructorSettings.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="InstructorSettings.resx">
