    <EmbeddedResource Update="InstructorProfileSettings.resx">
      <DependentUpon>InstructorProfileSettings.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="InstructorAnnouncements.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="InstructorAnnouncements.Designer.cs">
